// This repository packages a ready-made ".NET helper" assistant that Amplifier can install, so a project can get expert help with .NET build, test, and troubleshooting tasks.
digraph dotnet_ops {
    rankdir=LR
    fontname="Helvetica"
    fontsize=12
    label=".NET Operations Helper — v1.2.1\nA packaged add-on that gives Amplifier a .NET build-and-test expert"
    labelloc=t
    labeljust=c
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="94531b62e8594e83e48ceeb0b5c102f6bdf8eb645a441ce17d0b331c5adb53c2"

