    }

    subgraph cluster_agents {
        label="The Specialist You Can Ask (Agents)"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        agt_dotnet_ops [label="The .NET Expert\nBuilds, tests, and fixes .NET projects\n~686 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
    }

    subgraph cluster_context {
        label="Written Instructions It Reads (Context Files)"
        style="filled"
        fillcolor="#f9f9f9"
