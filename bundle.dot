        ctx_delegation_instructions_md [label="When To Hand Work To The Expert\ndelegation-instructions.md\n~249 tok", shape=box, fillcolor="#e1bee7", style="filled,rounded"]
    }

    subgraph cluster_legend {
        label="Colour Key"
        style="filled"
        fillcolor="white"
        color="#cccccc"
        fontsize=9

        leg_root [label="the package", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", fontsize=9]
        leg_behavior [label="switched-on ability", shape=box, fillcolor="#e0f2f1", style="filled,rounded", fontsize=9]
        leg_agent [label="specialist helper", shape=box, fillcolor="#c8e6c9", style="filled,rounded", fontsize=9]
        leg_module [label="add-on capability", shape=box, fillcolor="#bbdefb", style="filled,rounded", fontsize=9]
        leg_provider [label="AI service used", shape=box, fillcolor="#e0e0e0", style="filled,rounded", fontsize=9]
        leg_context [label="written instructions", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_standalone [label="works on its own", shape=box, fillcolor="#80cbc4", style="filled,rounded", fontsize=9]
        leg_experiment [label="experimental", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_ext_cost [label="borrowed, adds cost", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2, fontsize=9]
        leg_ext_muted [label="borrowed, free", shape=box, fillcolor="#f5f5f5", style="dashed", fontsize=9]
    }

    disclaimer [label="\"Tokens\" measure how much reading the AI must do (~4 characters each)\nSolid border = lives in this repository (counted here)\nDashed + red = borrowed from elsewhere, adds hidden reading cost\nDashed + muted = borrowed from elsewhere, no added cost\nNot counted: work done in side conversations, anything decided while running", shape=note, fillcolor="#eceff1", style="filled", fontsize=9]


    root_dotnet_ops -> beh_dotnet_ops_behavior [label="includes"]
    beh_dotnet_ops_behavior -> ctx_delegation_instructions_md [style=dotted, color=purple]
